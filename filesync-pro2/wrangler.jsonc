// «الداهية» on Cloudflare Workers. Build: `npm run build` (Vite → dist/), then `npx wrangler deploy`.
// Secrets (set in the Cloudflare dashboard, never in this file): GEMINI_API_KEY, GEMINI_PAID_API_KEY,
// STATS_KEY, GOOGLE_MAPS_API_KEY, GOOGLE_WEATHER_API_KEY, OWNER_EMAIL (where «راسلني» messages go; kept out of
// this public repo), X_BEARER_TOKEN (reads the season's official X account).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-dahiah",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/live", "/stats", "/stamps", "/teach", "/inbox", "/visitors", "/shots", "/survey"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "al-dahiah", "database_id": "2c2e065d-5058-42e3-a8f7-ec8134be35ee" }],
  // Express's body-parser pulls in iconv-lite, which does not bundle for Workers
  "alias": { "iconv-lite": "./server/iconvStub.js" },
  // The site's own address (registered on Cloudflare): both point at this Worker
  "routes": [
    { "pattern": "al-dahiah.com", "custom_domain": true },
    { "pattern": "www.al-dahiah.com", "custom_domain": true }
  ],
  // News from @QASABSALTSEASON on X every 30 minutes (needs the secret X_BEARER_TOKEN)
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true },
  "keep_vars": true,
  "vars": { "NODE_ENV": "production" }
}
