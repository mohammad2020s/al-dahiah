// «الداهية» on Cloudflare Workers. Build: `npm run build` (Vite → dist/), then `npx wrangler deploy`.
// Secrets (set in the Cloudflare dashboard, never in this file): GEMINI_API_KEY, GEMINI_PAID_API_KEY,
// STATS_KEY, GOOGLE_MAPS_API_KEY, GOOGLE_WEATHER_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-dahiah",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/live", "/stats", "/stamps"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "al-dahiah" }],
  // Express's body-parser pulls in iconv-lite, which does not bundle for Workers
  "alias": { "iconv-lite": "./server/iconvStub.js" },
  "observability": { "enabled": true },
  "keep_vars": true,
  "vars": { "NODE_ENV": "production" }
}
